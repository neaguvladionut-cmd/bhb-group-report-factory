{
  "name": "bhb-group-report-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "test:required": "node --test $(ls tests/*.test.mjs | grep -v /pptx.test.mjs)",
    "test:pptx": "node --test tests/pptx.test.mjs",
    "check:root": "node tools/check-root.mjs"
  }
}
